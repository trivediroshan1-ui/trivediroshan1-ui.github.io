<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>Roshan Trivedi &#8212; Writing</title>
    <link>https://roshantrivedi.co.in/writing/</link>
    <description>Analysis on AI security, agentic AI governance, identity and privileged access.</description>
    <language>en</language>
    <copyright>Roshan Trivedi. Writing under CC BY 4.0: https://roshantrivedi.co.in/copyright/</copyright>
    <atom:link href="https://roshantrivedi.co.in/feed.xml" rel="self" type="application/rss+xml" />
    {% for post in site.posts limit: 20 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>https://roshantrivedi.co.in{{ post.url }}</link>
      <guid isPermaLink="true">https://roshantrivedi.co.in{{ post.url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.description | xml_escape }}</description>
      <content:encoded><![CDATA[{{ post.content | replace: 'href="/', 'href="https://roshantrivedi.co.in/' | replace: 'src="/', 'src="https://roshantrivedi.co.in/' }}<p><em>Originally published at <a href="https://roshantrivedi.co.in{{ post.url }}">roshantrivedi.co.in{{ post.url }}</a> by Roshan Trivedi, under <a href="https://roshantrivedi.co.in/copyright/">CC BY 4.0</a>.</em></p>]]></content:encoded>
    </item>
    {% endfor %}
  </channel>
</rss>
